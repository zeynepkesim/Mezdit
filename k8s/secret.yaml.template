# Bu dosyayı secret.yaml olarak kopyalayın ve gerçek değerleri girin
# UYARI: secret.yaml dosyasını .gitignore'a ekleyin!
apiVersion: v1
kind: Secret
metadata:
  name: backend-secret
  namespace: emzops-staging
type: Opaque
stringData:
  # Eğer CloudNativePG kullanıyorsanız:
  # DATABASE_URL: "postgresql://devops:YOUR_PASSWORD@postgres-cluster-rw:5432/devops"

  # Eğer StatefulSet kullanıyorsanız:
  DATABASE_URL: "postgresql://devops:YOUR_PASSWORD@postgres-service:5432/devops"

  # YOUR_PASSWORD'u postgres-secret.yaml'daki şifre ile değiştirin
