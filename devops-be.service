[Unit]
Description=DevOps Backend API Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu

# Environment variables
Environment="DATABASE_URL=postgres://postgres@localhost:5432/postgres?sslmode=disable"
Environment="JWT_SECRET=your-secret-key-here-change-this"
Environment="PORT=8080"

# Service executable
ExecStart=/usr/local/bin/devops-be

# Restart policy
Restart=on-failure
RestartSec=5s

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=devops-be

[Install]
WantedBy=multi-user.target
